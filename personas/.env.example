# Copy to .env (git-ignored). Any OpenAI-compatible chat completions endpoint works.
# Google Gemini (free tier: https://aistudio.google.com -> Get API key)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
# Groq instead:  LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.1-8b-instant
